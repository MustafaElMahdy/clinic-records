# Password reset
msgid "Reset Password"
msgstr "إعادة تعيين كلمة المرور"

msgid "Enter your email address and we'll send you a link to reset your password."
msgstr "أدخل عنوان بريدك الإلكتروني وسنرسل لك رابطاً لإعادة تعيين كلمة المرور."

msgid "Send Reset Link"
msgstr "إرسال رابط الإعادة"

msgid "← Back to Login"
msgstr "← العودة إلى تسجيل الدخول"

msgid "Check Your Email"
msgstr "تحقق من بريدك الإلكتروني"

msgid "If an account exists for that email address, you'll receive a password reset link shortly."
msgstr "إذا كان هناك حساب مرتبط بهذا البريد الإلكتروني، ستصلك رسالة إعادة تعيين قريباً."

msgid "Didn't receive it? Check your spam folder, or make sure you entered the email address associated with your account."
msgstr "لم تستلمها؟ تحقق من مجلد الرسائل غير المرغوب فيها، أو تأكد من إدخال البريد الإلكتروني المرتبط بحسابك."

msgid "Back to Login"
msgstr "العودة إلى تسجيل الدخول"

msgid "Set New Password"
msgstr "تعيين كلمة مرور جديدة"

msgid "Enter and confirm your new password below."
msgstr "أدخل وأكّد كلمة مرورك الجديدة أدناه."

msgid "Link Expired"
msgstr "انتهت صلاحية الرابط"

msgid "This password reset link is invalid or has already been used. Reset links expire after 3 days."
msgstr "رابط إعادة التعيين هذا غير صالح أو تم استخدامه بالفعل. تنتهي صلاحية الروابط بعد 3 أيام."

msgid "Request a New Link"
msgstr "طلب رابط جديد"

msgid "Password Reset Complete"
msgstr "اكتملت إعادة تعيين كلمة المرور"

msgid "Password Changed"
msgstr "تم تغيير كلمة المرور"

msgid "Your password has been set. You can now log in with your new password."
msgstr "تم تعيين كلمة مرورك. يمكنك الآن تسجيل الدخول بكلمة المرور الجديدة."

msgid "Log In"
msgstr "تسجيل الدخول"

# Password reset email
msgid "You're receiving this email because a password reset was requested for your account at DocuMed."
msgstr "تلقيت هذا البريد الإلكتروني لأنه تم طلب إعادة تعيين كلمة المرور لحسابك في دوكيوميد."

msgid "Click the link below to set a new password:"
msgstr "انقر على الرابط أدناه لتعيين كلمة مرور جديدة:"

msgid "This link will expire in 3 days."
msgstr "سينتهي صلاحية هذا الرابط بعد 3 أيام."

msgid "If you did not request a password reset, you can ignore this email. Your password will not change."
msgstr "إذا لم تطلب إعادة تعيين كلمة المرور، يمكنك تجاهل هذا البريد الإلكتروني. لن تتغير كلمة مرورك."

